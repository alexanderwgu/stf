# STF Local Development Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env

# =============================================================================
# Android SDK (required for virtual devices / emulators)
# =============================================================================
STF_LOCAL_VIRTUAL_ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
STF_LOCAL_VIRTUAL_AVDMANAGER_PATH="$HOME/Library/Android/sdk/cmdline-tools/latest/bin/avdmanager"
STF_LOCAL_VIRTUAL_EMULATOR_PATH="$HOME/Library/Android/sdk/emulator/emulator"
STF_LOCAL_VIRTUAL_ADB_PATH="$HOME/Library/Android/sdk/platform-tools/adb"
STF_LOCAL_VIRTUAL_TEMPLATE_SYSTEM_IMAGE="system-images;android-30;google_apis;arm64-v8a"

# Path to ADB Keyboard APK (required for AI text input on device)
# Download from: https://github.com/nicnocquee/AdbKeyboard/releases
STF_LOCAL_VIRTUAL_ADB_KEYBOARD_APK_PATH="/path/to/ADBKeyboard.apk"

# =============================================================================
# AI Automation (required for AI task features)
# =============================================================================

# Path to the AutoGLM repo checkout
STF_LOCAL_AI_AGENT_ROOT="/path/to/AutoGLM"

# Python interpreter (must be 3.10+)
STF_LOCAL_AI_PYTHON_PATH="python3"

# --- Model provider (uncomment ONE section) ---

# Option 1: Google Gemini (recommended — cheapest for vision tasks)
STF_LOCAL_AI_MODEL_BASE_URL="https://generativelanguage.googleapis.com"
STF_LOCAL_AI_MODEL_NAME="gemini-3-flash-preview"
STF_LOCAL_AI_API_KEY="your-gemini-api-key"

# Option 2: SiliconFlow (Qwen3-VL)
# STF_LOCAL_AI_MODEL_BASE_URL="https://api.siliconflow.cn/v1"
# STF_LOCAL_AI_MODEL_NAME="Qwen/Qwen3-VL-235B-A22B-Instruct"
# STF_LOCAL_AI_API_KEY="your-siliconflow-api-key"

# Option 3: Z.AI (AutoGLM native model)
# STF_LOCAL_AI_MODEL_BASE_URL="https://api.z.ai/api/paas/v4"
# STF_LOCAL_AI_MODEL_NAME="autoglm-phone-multilingual"
# STF_LOCAL_AI_API_KEY="your-z-ai-api-key"

# Option 4: Local vLLM / SGLang server
# STF_LOCAL_AI_MODEL_BASE_URL="http://localhost:8000/v1"
# STF_LOCAL_AI_MODEL_NAME="autoglm-phone-9b"
# STF_LOCAL_AI_API_KEY="EMPTY"

# Prompt language: "en" (English) or "cn" (Chinese)
STF_LOCAL_AI_LANG="en"

# =============================================================================
# AI Memory & Logging (optional — defaults shown)
# =============================================================================
# STF_LOCAL_AI_LOG_TAIL_MAX=4000
# STF_LOCAL_AI_MEMORY_SUMMARY_ENABLED=true
# STF_LOCAL_AI_MEMORY_SUMMARY_MAX_INPUT_CHARS=5000
# STF_LOCAL_AI_MEMORY_SUMMARY_MODEL=            # defaults to same as AI_MODEL_NAME
